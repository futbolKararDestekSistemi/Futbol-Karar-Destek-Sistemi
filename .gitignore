# Futbol Karar Destek Sistemi — .gitignore (Proje Kökü)

# ─── Node.js Bağımlılıkları ───────────────────────────────────────────────────
node_modules/

# ─── Ortam Değişkenleri (API ANAHTARI BURADA!) ───────────────────────────────
.env
.env.local
.env.*.local

# ─── Veritabanı Dosyası ───────────────────────────────────────────────────────
server/data/

# ─── Build / Derleme Çıktıları ────────────────────────────────────────────────
dist/
build/
client/dist/

# ─── Log Dosyaları ────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── İşletim Sistemi Dosyaları ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE Ayar Dosyaları ──────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
